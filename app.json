    "url": "https://github.com/torgnywalin/homey-adax-local/issues"
  },
  "flow": {
    "triggers": [
      {
        "id": "local_change",
        "title": {
          "en": "The heater was changed outside Homey",
          "no": "Ovnen ble endret utenfor Homey"
        },
        "hint": {
          "en": "Someone used the buttons on the heater. Detected at the next poll. With lock or limit, Homey reverts the change (see “Reverted by Homey”).",
          "no": "Noen brukte knappene på ovnen. Oppdages ved neste avlesning. Med lås eller begrensning setter Homey endringen tilbake (se «Satt tilbake av Homey»)."
        },
        "tokens": [
          {
            "name": "temperature",
            "type": "number",
            "title": {
              "en": "Temperature set on the heater (0 = off)",
              "no": "Temperatur satt på ovnen (0 = av)"
            },
            "example": 22
          },
          {
            "name": "corrected",
            "type": "boolean",
            "title": {
              "en": "Reverted by Homey",
              "no": "Satt tilbake av Homey"
            },
            "example": false
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heater"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "local_changes_is",
        "title": {
          "en": "Changes on the heater !{{are|are not}} set to …",
          "no": "Endringer på ovnen !{{er|er ikke}} satt til …"
        },
        "titleFormatted": {
          "en": "Changes on the heater !{{are|are not}} set to [[mode]]",
          "no": "Endringer på ovnen !{{er|er ikke}} satt til [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heater"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "title": {
              "en": "Changes on the heater",
              "no": "Endringer på ovnen"
            },
            "values": [
              {
                "id": "allow",
                "title": {
                  "en": "Allow",
                  "no": "Tillat"
                }
              },
              {
                "id": "limit",
                "title": {
                  "en": "Limit ±3 °C",
                  "no": "Begrens ±3 °C"
                }
              },
              {
                "id": "lock",
                "title": {
                  "en": "Lock",
                  "no": "Lås"
                }
              }
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_local_changes",
        "title": {
          "en": "Set changes on the heater to …",
          "no": "Sett endringer på ovnen til …"
        },
        "titleFormatted": {
          "en": "Set changes on the heater to [[mode]]",
          "no": "Sett endringer på ovnen til [[mode]]"
        },
        "hint": {
          "en": "Lock or limit the buttons on the heater, e.g. at night. The current temperature is kept.",
          "no": "Lås eller begrens knappene på ovnen, f.eks. om natten. Gjeldende temperatur beholdes."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=heater"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "title": {
              "en": "Changes on the heater",
              "no": "Endringer på ovnen"
            },
            "values": [
              {
                "id": "allow",
                "title": {
                  "en": "Allow",
                  "no": "Tillat"
                }
              },
              {
                "id": "limit",
                "title": {
                  "en": "Limit ±3 °C",
                  "no": "Begrens ±3 °C"
                }
              },
              {
                "id": "lock",
                "title": {
                  "en": "Lock",
                  "no": "Lås"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Adax heater (local)",
        "no": "Adax-ovn (lokal)"
      },
      "class": "heater",
      "capabilities": [
        "onoff",
        "target_temperature",
        "measure_temperature",
        "measure_power"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 5,
          "max": 35,
          "step": 1,
          "decimals": 0
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "ble",
        "lan"
      ],
      "images": {
        "small": "/drivers/heater/assets/images/small.png",
        "large": "/drivers/heater/assets/images/large.png",
        "xlarge": "/drivers/heater/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "instructions"
        },
        {
          "id": "wifi"
        },
        {
          "id": "manual"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "repair"
        },
        {
          "id": "wifi"
        }
      ],
      "id": "heater",
      "settings": [
        {
          "id": "ip",
          "type": "text",
          "label": {
            "en": "IP address",
            "no": "IP-adresse"
          },
          "value": "",
          "hint": {
            "en": "The heater's IP address. Give the heater a fixed IP (DHCP reservation) in your router.",
            "no": "Ovnens IP-adresse. Gi ovnen fast IP (DHCP-reservasjon) i ruteren."
          }
        },
        {
          "id": "local_changes",
          "type": "dropdown",
          "label": {
            "en": "Changes on the heater",
            "no": "Endringer på ovnen"
          },
          "value": "allow",
          "values": [
            {
              "id": "allow",
              "label": {
                "en": "Allow",
                "no": "Tillat"
              }
            },
            {
              "id": "limit",
              "label": {
                "en": "Limit ±3 °C",
                "no": "Begrens ±3 °C"
              }
            },
            {
              "id": "lock",
              "label": {
                "en": "Lock",
                "no": "Lås"
              }
            }
          ],
          "hint": {
            "en": "What happens when someone uses the buttons on the heater. Limit: the temperature may be adjusted ±3 °C from the value set in Homey (on/off is allowed). Lock: every change is reverted to the Homey value. Corrections happen at the next poll (30–60 s), as the heater has no lock of its own in local mode.",
            "no": "Hva som skjer når noen bruker knappene på ovnen. Begrens: temperaturen kan justeres ±3 °C fra verdien satt i Homey (av/på er tillatt). Lås: alle endringer settes tilbake til Homey-verdien. Rettingen skjer ved neste avlesning (30–60 s), siden ovnen ikke har egen lås i lokal modus."
          }
        },
        {
          "id": "rated_power",
          "type": "number",
          "label": {
            "en": "Heater power",
            "no": "Ovnens effekt"
          },
          "value": 0,
          "min": 0,
          "max": 5000,
          "step": 50,
          "units": {
            "en": "W",
            "no": "W"
          },
          "hint": {
            "en": "The heater's rated power (see the label on the heater). Homey shows this power while the heater is heating (on and below target temperature) and calculates energy from it. 0 = not set (no power is shown). This is an estimate: the heater does not measure power.",
            "no": "Ovnens merkeeffekt (se merkeskiltet på ovnen). Homey viser denne effekten mens ovnen varmer (på og under måltemperatur), og regner ut energi fra den. 0 = ikke satt (ingen effekt vises). Dette er et estimat: ovnen måler ikke effekt."
          }
        },
        {
          "id": "poll_interval",
          "type": "number",
          "label": {
            "en": "Poll interval",
            "no": "Oppdateringsintervall"
          },
          "value": 60,
          "min": 30,
          "max": 600,
          "units": {
            "en": "seconds",
            "no": "sekunder"
          },
          "hint": {
            "en": "How often Homey reads the temperature. Too frequent polling can make the heater unstable.",
            "no": "Hvor ofte Homey leser temperaturen. For hyppig polling kan gjøre ovnen ustabil."
          }
        },
        {
          "id": "mac",
          "type": "label",
          "label": {
            "en": "WiFi MAC",
            "no": "WiFi-MAC"
          },
          "value": ""
        },
        {
          "id": "model",
          "type": "label",
          "label": {
            "en": "Model",
            "no": "Modell"
          },
          "value": ""
        },
        {
          "id": "firmware",
          "type": "label",
          "label": {
            "en": "Firmware",
            "no": "Firmware"
          },
          "value": ""
        }
      ]
    }
  ]
}